{
  "name": "nio-guru-server",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "node ../../bin/nio-guru.js --dev --no-browser",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --alias:@nio-labs/nio-guru-personas=../../packages/gurus/src/index.ts --outfile=dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@nio-labs/nio-db.js": "1.0.5",
    "@nio-labs/nio-guru-personas": "workspace:*",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
