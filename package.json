{
  "name": "@nio-labs/nio-guru",
  "version": "0.5.0",
  "description": "NioGuru — a multi-expert AI workspace powered by Nio",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter nio-guru-server --filter nio-guru-web dev",
    "dev:server": "pnpm --filter nio-guru-server dev",
    "dev:web": "pnpm --filter nio-guru-web dev",
    "build": "pnpm --filter nio-guru-web build && pnpm --filter nio-guru-server build",
    "start": "node bin/nio-guru.js --no-browser",
    "nio-guru": "node bin/nio-guru.js",
    "prepack": "npx --yes pnpm@11.22.0 build"
  },
  "bin": {
    "nio-guru": "./bin/nio-guru.js"
  },
  "keywords": [
    "ai",
    "nio",
    "nio-ai",
    "chat",
    "gurus",
    "hono",
    "vue3",
    "shadcn"
  ],
  "author": "nio-labs",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nio-labs/nio-guru.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/nio-guru.js",
    "apps/server/dist",
    "apps/web/dist",
    "README.md"
  ],
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@nio-labs/nio-db": "1.0.5",
    "@nio-labs/nio-db.js": "1.0.5",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "nanoid": "^5.0.9"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/nio-labs/nio-guru#readme",
  "bugs": {
    "url": "https://github.com/nio-labs/nio-guru/issues"
  }
}
